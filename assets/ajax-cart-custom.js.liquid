function setUpsells(type){
    Window.upsellsData = [];
    let upsellsForType = document.querySelector(`[name="${type}-upsells"]`);
    if(upsellsForType != undefined){
        document.querySelector('.upsell-carousel-container').style.display = "block";
        let upsells = upsellsForType.content.split(",");
        $('.upsell-carousel').slick('unslick');
        upsells.forEach(upsellHandle => {
           getProductInfo(upsellHandle,upsells.length);
        })
    }else{
        document.querySelector('.upsell-carousel-container').style.display = "none";
    }

}

function UpsellElement(title, variantId, price, image) {

    return `
        <div class="upsell-carousel-item" data-upsellitemid="${variantId}">
            <div class="upsell-image">
                <img class="ctm_image_set" src="${image}">
            </div>
            <div class="upsell-info">
                <span class="upsell-item-title">${title}</span>
                <span class="upsell-item-price">
                    <span class="money">${price}</span>
                </span>
            <span class="upsell-item-atc" data-upsellid="${variantId}" onclick="addItemToCart(${variantId},1)">ADD</span>
            </div>
        </div>
  `;

}

function getProductInfo(handle,length){
    $.ajax({
        type: 'GET',
        url: `/products/${handle}.js`,
        async: true,
        dataType: 'json',
        success: function(upsell) {
            let data = {title: upsell.title, variantId: upsell.variants[0].id, price: `$${(upsell.price / 100).toFixed(2)}`, image: upsell.featured_image, quantity: 1};
            Window.upsellsData.push(data);
            if(Window.upsellsData.length == length){
                document.querySelector(`.upsell-carousel`).innerHTML = ``;
                
                Window.upsellsData.forEach(upsell => {
                    UpsellElement(upsell.title, upsell.variantId, upsell.price, upsell.image);
                    document.querySelector(`.upsell-carousel`).innerHTML += UpsellElement(upsell.title, upsell.variantId, upsell.price, upsell.image);
                })
                $('.upsell-carousel').slick({
                    dots: false,
                    infinite: true,
                    arrows: false,
                    slidesToShow: 1,
                    centerPadding: "5%",
                });

                setTimeout(() => {
                    setMaxHeightOfCartDrawer();
                }, 250);

            }
        }
    });
}

function fetchCart() {
    console.log('fetching cart....')
    $.ajax({
        type: 'GET',
        url: '/cart.js',
        dataType: 'json',
        success: function(cart) {
            if(cart.items.length != 0){
                setUpsells(cart.items[0].product_type);
            }
            onCartUpdate(cart);
            console.log(window.BOLD);
            if(window.BOLD && BOLD.common && BOLD.common.cartDoctor && typeof BOLD.common.cartDoctor.fix === 'function'){
                cart = BOLD.common.cartDoctor.fix(cart);
             }
          console.log(cart);
            if (cart.item_count === 0) {
                cartDrawerContent.innerHTML = `<div class="cart-empty">
                    <h5 class="cart-empty__title">Your cart is currently empty.</h5>
                    <span class="emoji cart-empty__emoji">
                        <i class="icon icon--sad"></i>
                    </span>
                    <a href="/collections/all-products" class="c-btn c-btn--primary c-btn--full">Shop Now</a>
                </div>`;
                //checkoutButton.classList.add('is-hidden');
               $(".ajax-cart-drawer__button-and-subtotal").addClass("is-hidden");
              $(".free-shipping-heading").html("").addClass("empty");
              $(".subtotal-amount").html("");
            //   $(".items-in-cart").html("");
            } else {
              console.log();
                renderCart(cart);
                //checkoutButton.classList.remove('is-hidden');
              $(".ajax-cart-drawer__button-and-subtotal").removeClass("is-hidden");
               $(".free-shipping-heading").removeClass("empty");
            }
            if(window.BOLD && BOLD.common && BOLD.common.eventEmitter && typeof BOLD.common.eventEmitter.emit === 'function'){
                BOLD.common.eventEmitter.emit('BOLD_COMMON_cart_loaded', cart);
            }
            setProgress(cart.total_price / 100)
        }
    });
}

function changeItem(data, callback) {
    const quantity = data.quantity;
    $.ajax({
        type: 'POST',
        url: '/cart/change.js',
        data: 'quantity=' + quantity + '&id=' + data.id,
        dataType: 'json',
        success: function(cart) {
            if ((typeof callback) === 'function') {
                callback(cart);
            } else {
                var x = localStorage.getItem("gift");
                console.log(x);
                console.log(data.id);
                onCartUpdate(cart);
                fetchCart();
            }
        },
    });
}

function onCartUpdate(cart) {
//   document.getElementById('cart_item_count').innerHTML = cart.item_count;

    let announcement_bar = document.querySelector('.announcement-bar__message');

    if(announcement_bar != undefined){
        // Check if free shipping countdown is enabled by checking if data attributes exist
        if(announcement_bar.dataset.threshold && announcement_bar.dataset.thresholdmessage && announcement_bar.dataset.thresholdtext){
            let free_shipping_threshold = announcement_bar.dataset.threshold;
            let threshold_message = announcement_bar.dataset.thresholdmessage;
            let threshold_text = announcement_bar.dataset.thresholdtext;
            let new_shipping_counter = free_shipping_threshold - cart.total_price;
            let price = (Number(new_shipping_counter) / 100).toFixed(2);
            if(price > 0){
                announcement_bar.innerHTML = `${threshold_text.replace("[price]",`$${price}`)}`;
            }else{
                announcement_bar.innerHTML = threshold_message;
            }
        }
        // If free shipping countdown is disabled, don't modify the announcement bar content
        // It will display the static text set by the Liquid template
    }

    

    
}

