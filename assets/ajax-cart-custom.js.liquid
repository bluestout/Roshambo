    $('html').addClass('cart-drawer-open');

    setTimeout(() => {
        setMaxHeightOfCartDrawer();
        document.querySelector('.upsell-carousel').style.opacity = 1;
    }, 500);

}

function closeCartDrawer() {
    cartDrawer.classList.remove('is-open');
  $('html').removeClass('cart-drawer-open');
}

