 function addItemToCart(variant_id, qty) {
    let isShowingUpsells = document.querySelector('.upsell-carousel-container').style.display == "none" ? false : true;
    if(isShowingUpsells){
        $('.upsell-carousel').slick("slickNext")
    }

    data = {
      "id": Number(variant_id),
      "quantity": qty
    }
    jQuery.ajax({
      type: 'POST',
      url: '/cart/add.js',
      data: data,
      dataType: 'json',
      success: function () {
        let isWholesale = document.querySelector("[data-isWholesale]").dataset.iswholesale == "true";
        if(isWholesale){
         window.location.href = "/cart";
        }else{
          fetchCart();
          openCartOverlay();
          openCartDrawer();
          
        }

      
      },
  
      error: function () {
        console.log("Sorry, That item is not available")
      }
    });
}
  
function reChargeProcessCart() {
	function get_cookie(name){ return( document.cookie.match('(^|; )'+name+'=([^;]*)')||0 )[2] }
	do {
      		token=get_cookie('cart');
	}
    while(token == undefined);	
    let myshopify_domain='roshambobaby.myshopify.com'
	try { let ga_linker = ga.getAll()[0].get('linkerParam') } catch(err) { var ga_linker ='' }
	return "https://checkout.rechargeapps.com/r/checkout?myshopify_domain="+myshopify_domain+"&cart_token="+token+"&"+ga_linker;
}


function hasRechargeProduct(){
    let isRechargeProduct = false;
    $.getJSON('/cart', function (results) {
    var has_subscription_product = false;
        $.each(results.items, function (i, item) {
            if( !has_subscription_product ){
                if(item.properties!== null){
                    $.each(item.properties, function (j, property) {
                        if(j=='shipping_interval_frequency'){
                            has_subscription_product = true;
                        }          
                    });
                }
            }  
        });
    if( has_subscription_product ){
        window.location.href = reChargeProcessCart();
    }else{
        window.location.href = "/checkout";
    }
});

    return isRechargeProduct;
}

