        if ($el.hasClass('js-qty__adjust--plus')) {
            qty += 1
        } else {
            qty -= 1;
            if (qty < 1)
                qty = 0
        }
        
        
        $qtySelector.val(qty);
        
        let variant = $(this).closest(".ajax-cart-item").data("variant");
        
        let data = {
            id: Number(variant),
            quantity: qty
        }

        console.log(data)
        changeItem(data);
    
    
    });
}
 validateQty = function(qty) {
   if ((parseFloat(qty) == parseInt(qty)) && !isNaN(qty)) {} else {
     qty = 1
   }
   return qty
 }
 
