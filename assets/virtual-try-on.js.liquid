function getToken(){

  console.log('getToken');
  
  var retake = $('.btn-scan').attr('retake');
  console.log(retake);
  if(retake == true || retake == 'true') {
    delete_cookie('vtoscanid');
    delete_cookie('vtooverlay');
      jQuery('.btn-scan').html('Virtual Try on');
            jQuery('.btn-scan').attr('retake', 'false');
    getToken();
    jQuery('.btn-scan').removeClass('ditto-tryon');
  }else {
  $('#ditto-tryon').addClass('scan-opened');
  jQuery('.btn-scan').html('Retake');
  jQuery('.btn-scan').attr('retake', 'true');
  // Set up our HTTP request
  var xhr = new XMLHttpRequest();

  // Setup our listener to process completed requests
  xhr.onload = function () {

      // Process our return data
      if (xhr.status >= 200 && xhr.status < 300) {
      let response =JSON.parse(xhr.responseText);
          signature = response["X-Ditto-Signature"];
        
          console.log('signature', signature);
          checkVTO();
      } else {
      getToken();
      }
  };

  // Create and send a GET request
  // The first argument is the post type (GET, POST, PUT, DELETE, etc.)
  // The second argument is the endpoint URL
  xhr.open('GET', 'https://www.roshambo.com/tools/token');
  xhr.send();
}
}

function delete_cookie(name) {
  document.cookie = name +'=; Expires=Thu, 01 Jan 1970 00:00:01 GMT; path=/;';
  console.log('delete');
}

