{%- assign item = section.settings -%}
{% comment %} Wholesale_Club_Item_Prices Start {% endcomment %}
{% if item.product %}{% assign base_product = item.product %}{% else %}{% assign base_product = item %}{% endif %}
{% if item.variant %}{% assign base_variant = item.variant %}{% else %}{% assign base_variant = item.selected_or_first_available_variant %}{% endif %}

{% if shop.metafields.sawholesale['base_price'] == blank %}
  {% assign base_price = 'compare_at_price' %}
{% else %}
  {% assign base_price = shop.metafields.sawholesale['base_price'] %}
{% endif %}

{% assign saw_discount = 0 %}{% assign saw_has_discount = false %}

{% if customer.tags != blank %}
  {% for mf in base_product.metafields.sawholesale %}
    {% capture product_customer_tag %}{{ mf | first | replace: 'discount_', '' }}{% endcapture %}
    {% if customer.tags contains product_customer_tag %}
      {% assign saw_has_discount = true %}
      {% assign discount_key = product_customer_tag | prepend: 'discount_' %}
      {% assign price_key = product_customer_tag | prepend: 'price_' %}
      {% assign saw_discount = base_product.metafields.sawholesale[discount_key] | divided_by: 100.0 %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign saw_discount = 1 | minus: saw_discount %}

{% if base_price == 'price' or base_variant.compare_at_price == blank  or base_variant.compare_at_price == 0 or base_variant.compare_at_price < base_variant.price %}
  {% assign saw_variant_compare_at_price = base_variant.price %}
{% else %}
  {% assign saw_variant_compare_at_price = base_variant.compare_at_price %}
{% endif %}

{% assign cpe = shop.metafields.sawholesale['cpe'] | default: "true" %}
{% if base_variant.metafields.sawholesale[price_key] != blank and cpe == "true" %}
  {% assign saw_variant_price = base_variant.metafields.sawholesale[price_key] %}
{% else %}
  {% assign saw_variant_price = saw_variant_compare_at_price | times: saw_discount %}
{% endif %}

{% if saw_has_discount == false or saw_variant_price >= saw_variant_compare_at_price %}
  {% assign WCItem_OriginalPrice = item.original_price %}
  {% assign WCItem_FinalPrice = item.final_price %}
  {% assign WCItem_Price = item.price %}
  {% assign WCItem_PriceMin = item.price_min %}
  {% assign WCItem_PriceMax = item.price_max %}
  {% assign WCItem_CompareAtPrice = item.compare_at_price %}
  {% assign WCItem_CompareAtPriceMin = item.compare_at_price_min %}
  {% assign WCItem_CompareAtPriceMax = item.compare_at_price_max %}
  {% assign WCItem_OriginalLinePrice = item.original_line_price %}
  {% assign WCItem_FinalLinePrice = item.final_line_price %}
  {% assign WCItem_LinePrice = item.line_price %}
{% else %}
  {% assign WCItem_OriginalPrice = saw_variant_compare_at_price %}
  {% assign WCItem_FinalPrice = saw_variant_price %}
  {% assign WCItem_Price = saw_variant_price %}
  {% assign WCItem_PriceMin = item.price_min | times: saw_discount %}
  {% assign WCItem_PriceMax = item.price_max | times: saw_discount %}
  {% assign WCItem_CompareAtPrice = saw_variant_compare_at_price %}
  {% if base_product.compare_at_price_min != 0 %}{% assign WCItem_CompareAtPriceMin = base_product.compare_at_price_min %}{% else %}{% assign WCItem_CompareAtPriceMin = base_product.price_min %}{% endif %}
  {% if base_product.compare_at_price_max != 0 %}{% assign WCItem_CompareAtPriceMax = base_product.compare_at_price_max %}{% else %}{% assign WCItem_CompareAtPriceMax = base_product.price_max %}{% endif %}
  {% assign WCItem_OriginalLinePrice = WCItem_OriginalPrice | round | times: item.quantity %}
  {% assign WCItem_FinalLinePrice = WCItem_FinalPrice | round | times: item.quantity %}
  {% assign WCItem_LinePrice = WCItem_Price | round | times: item.quantity %}
{% endif %}
{% comment %} Wholesale_Club_Item_Prices End {% endcomment %}

<div class="{% if template == 'index' %}{{ item.top_offset }}{% else %}{{ item.top_offset_normal }}{% endif %} {{ item.custom_classes }} for-footer-blocks iconbanners{{ section.id }}">
  {% if item.usebgcolor and item.useboxedbgcolor == false %}<div class="subsectionbg">{% endif %}
  {% if item.usebgcolor and item.useboxedbgcolor %}<div class="container subsectionbg">{% else %}<div class="container{% if item.fullwidth %}-fluid{% endif %}">{% endif %}
    {%- if item.show_title -%}
    <div class="tt-block-title{% if item.title_to_left %} text-left{% endif %}{% if item.boxed_title and item.fullwidth %} container{% endif %}">
      <h2 class="tt-title">{{ item.text1 }}</h2>
      {%- unless item.text2 == '' -%}<div class="tt-description">{{ item.text2 }}</div>{%- endunless -%}
    </div>
    {%- endif -%}
    <div class="row{% if item.items_always_in_center %} justify-content-center{% endif %} tt-services-listing{% if item.use_background %} tt-layout-02{% endif %}">
      {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}{%- assign b_i = block.settings -%}
      <div class="col-xs-12 col-md-6 col-lg-{{ item.items }}" {{ block.shopify_attributes }}>
        <a href="{{ b_i.link }}" class="tt-services-block{% if item.vertical %} tt-services-block-vertical{% endif %}" data-hovercolors>
          {%- if b_i.show_icon != 'none' -%}
          <div class="tt-col-icon">
            {%- if b_i.show_icon == 'image' -%}
            <img src="{{ b_i.image | img_url: '60x' }}" alt="{{ b_i.image.alt }}">
            {%- else -%}
            <i class="{{ b_i.icon }}" style="color: {% if item.same_iconcolor %}{{ item.icon_color }}{% else %}{{ b_i.icon_color }}{% endif %}"></i>
            {%- endif -%}
          </div>
          {%- endif -%}
          <div class="tt-col-description">
            <h4 class="tt-title" style="color:{{ item.title_color }};" data-c="{{ item.title_color }}" data-ac="{{ item.title_hover_color }}">{{ b_i.text1 }}</h4>
            {% unless b_i.text2 == '' %}<p style="color: {{ item.desc_color }}">{{ b_i.text2 }}</p>{% endunless %}
          </div>
        </a>
      </div>
      {%- endfor -%}
      {%- else -%}
      <span style="display: flex; justify-content: center;">This section doesn’t currently include any content. Add content to this section using the sidebar.</span>
      {%- endif -%}
    </div>
  {% if item.usebgcolor and item.useboxedbgcolor %}</div>{% else %}</div>{% endif %}
  {% if item.usebgcolor and item.useboxedbgcolor == false %}</div>{% endif %}
</div>
{% if item.usebgcolor or item.show_title %}
<style>
  {% if item.show_title %}
  {% if item.text1 != '' %}
  .iconbanners{{ section.id }} .tt-block-title .tt-title{
    color: {{ item.main_title_color }};
  }{% endif %}
  {% if item.text2 != '' %}
  .iconbanners{{ section.id }} .tt-block-title .tt-description{
    color: {{ item.main_desc_color }};
  }{% endif %}
  {% endif %}
  {% if item.usebgcolor %}
  .iconbanners{{ section.id }} .subsectionbg{
    background-color: {{ item.bgco }};
  }
  @media (min-width: 1025px){
    .iconbanners{{ section.id }} .subsectionbg{
      padding-top: {{ item.bgdepad }}px;
      padding-bottom: {{ item.bgdepad_2 }}px;
    }
  }
  @media (max-width: 1024px){
    .iconbanners{{ section.id }} .subsectionbg{
      padding-top: {{ item.bgmopad }}px;
      padding-bottom: {{ item.bgmopad_2 }}px;
    }
  }
  {% endif %}
</style>
{% endif %}

{% schema %}
{
  "name": "Icon Banners",
  "class": "index-section",
  "settings": [
      {
        "type": "select",
        "id": "top_offset",
        "label": "Top Offset. Only for index page",
        "default": "normal-onlyindex",
		"info": "Only for index page",
        "options": [
          {
            "value": "none-onlyindex",
            "label": "None"
          },
          {
            "value": "small-onlyindex",
            "label": "Small"
          },
          {
            "value": "normal-onlyindex",
            "label": "Normal"
          }
        ]
      },
      {
        "type": "select",
        "id": "top_offset_normal",
        "label": "Top Offset",
        "default": "tt-offset-normal_base",
        "options": [
          {
            "value": "nomargin_base",
            "label": "None"
          },
          {
            "value": "tt-offset-small_base",
            "label": "Small"
          },
          {
            "value": "tt-offset-normal_base",
            "label": "Normal"
          }
        ]
      },
      {
        "type": "textarea",
        "id": "custom_classes",
        "label": "Custom css classes",
        "info": "For the custom styles. Add your styles in the theme.css.liquid"
      },
      {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "Fullwidth size",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "vertical",
        "label": "Direction in banner is vertical",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "items_always_in_center",
        "label": "Items in center",
        "default": false
      },
      {
        "type": "select",
        "id": "items",
        "label": "Items in row",
        "options": [
          { "value": "6", "label": "2" },
          { "value": "4", "label": "3" },
          { "value": "3", "label": "4" }
        ],
        "default": "4",
        "info": "For screen size > 1024"
      },
      {
        "type": "header",
        "content": "Title"
      },
      {
        "type": "checkbox",
        "id": "show_title",
        "label": "Show title",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "title_to_left",
        "label": "Title to left",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "boxed_title",
        "label": "Boxed title when fullwidth",
        "default": false
      },
      {
        "type": "textarea",
        "id": "text1",
        "label": "Title",
        "default": "Title"
      },
      {
        "type": "textarea",
        "id": "text2",
        "label": "Description",
        "default": "Description"
      },
      {
        "type": "color",
        "id": "main_title_color",
        "label": "Title color",
        "default": "#191919"
      },
      {
        "type": "color",
        "id": "main_desc_color",
        "label": "Description color",
        "default": "#777777"
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "checkbox",
        "id": "same_iconcolor",
        "label": "Use same icon color",
        "default": true
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon color",
        "default": "#2879fe",
		"info": "Not image"
      },
      {
        "type": "color",
        "id": "title_color",
        "label": "Item title color",
        "default": "#191919"
      },
      {
        "type": "color",
        "id": "desc_color",
        "label": "Item description color",
        "default": "#777777"
      },
      {
        "type": "color",
        "id": "title_hover_color",
        "label": "Item title hover color",
        "default": "#2879fe"
      },
      {
        "type": "header",
        "content": "Background color"
      },
      {
        "type": "checkbox",
        "id": "usebgcolor",
        "label": "Use background color",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "useboxedbgcolor",
        "label": "Use boxed background color",
        "default": false
      },
      {
        "type": "color",
        "id": "bgco",
        "label": "Background color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "bgdepad",
        "label": "Vertical top padding desktop",
		"default": "80",
		"info": "integer, in px"
      },
      {
        "type": "text",
        "id": "bgdepad_2",
        "label": "Vertical bottom padding desktop",
		"default": "80",
		"info": "integer, in px"
      },
      {
        "type": "text",
        "id": "bgmopad",
        "label": "Vertical top padding mobile",
		"default": "80",
		"info": "integer, in px"
      },
      {
        "type": "text",
        "id": "bgmopad_2",
        "label": "Vertical bottom padding mobile",
		"default": "80",
		"info": "integer, in px"
      }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Banner",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        },
        {
          "type": "select",
          "id": "show_icon",
          "label": "Icon settings",
          "options": [
            { "value": "icon", "label": "Use font icon" },
            { "value": "image", "label": "Use image" },
            { "value": "none", "label": "Hide icon" }
          ],
          "default": "icon"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Wokiee icon",
          "default": "icon-f-48",
		  "info": "[Wokiee Icons](\/\/portotheme.com\/shopify\/wokiee\/icons)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image instead of icon",
          "info": "Image size 50x50px. Use *.png image"
        },
        {
          "type": "textarea",
          "id": "text1",
          "label": "Title",
          "default": "FREE SHIPPING"
        },
        {
          "type": "textarea",
          "id": "text2",
          "label": "Content",
		  "default": "Free Shipping on all orders from the US or orders of $ 99 or more."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#2879fe",
          "info": "Not image. Uncheck \"Use same icon color\""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Banners",
      "category": "Banner",
        "blocks": [
          {
            "type": "item",
            "settings": {
              "icon": "icon-f-48",
              "text1": "FREE SHIPPING",
              "text2": "Free Shipping on all orders from the US or orders of $ 99 or more."
            }
          },
          {
            "type": "item",
            "settings": {
              "icon": "icon-f-35",
              "text1": "SUPPORT 24/7",
              "text2": "Contact us 24 hours a day, 7 days a week"
            }
          },
          {
            "type": "item",
            "settings": {
              "icon": "icon-e-09",
              "text1": "30 DAYS RETURN",
              "text2": "Simply return it within 24 days for an exchange."
            }
          }
        ]
    }
  ]
}
{% endschema %}