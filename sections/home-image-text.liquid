{% if section.blocks.size > 0 %}
  <div class="grid_wrapper hmt">
  {% for block in section.blocks %}
    {% if block.settings.image != blank  or block.settings.image != blank %}
    <div class="gride_item">
    {% if block.settings.image != blank %}
      <a href="{{block.settings.link}}">
      <img src="{{ block.settings.image | img_url: 'x800' }}" alt="{{ block.settings.image.alt }}" loading="lazy">
      </a>
     {% endif %} 
    {% if block.settings.title != blank %}
       <a href="{{ block.settings.link }}" class="hmt-btn-b{{ forloop.index }} hmt-btn">{{ block.settings.title }}</a> 
     {% endif %} 
    </div>
      {% endif %}
  {% endfor %}
  </div>
{% endif %}
<style>
  
  
</style>
{% schema %}
  {
    "name": "Image Blocks",
    "settings": [
    ],
    "blocks": [
    {
      "type": "image",
      "name": "Grid",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Tell your story"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Image Blocks",
      "settings": {},
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
  }
{% endschema %}