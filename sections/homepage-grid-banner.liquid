<div class="grid_banner-outer">

    <div class="grid_banner-inner">

        <div class="grid_column">

            <div class="grid_row">

                <a href="{{section.settings.buttonLink1}}" class="grid_item">

                    <img class="lazyload" data-src="{{section.settings.bannerIMG1 | img_url: '300x'}}">

                    <span class="grid_item-button">{{section.settings.buttonText1}}</span>

                </a>

            </div>

            <div class="grid_row">

                <a href="{{section.settings.buttonLink2}}" class="grid_item">

                    <img class="lazyload" data-src="{{section.settings.bannerIMG2 | img_url: '300x'}}">

                    <span class="grid_item-button">{{section.settings.buttonText2}}</span>

                </a>

            </div>

        </div>

        <div class="grid_column-long">

            <div class="grid_row">

                <a href="{{section.settings.buttonLink3}}" class="grid_item">

                    <img class="lazyload" data-src="{{section.settings.bannerIMG3 | img_url: '500x800'}}">

                    <span class="grid_item-button">{{section.settings.buttonText3}}</span>

                </a>

            </div>

        </div>

        <div class="grid_column-wide">

            <div class="grid_row">

                <a href="{{section.settings.buttonLink4}}" class="grid_item">

                    <img class="lazyload" data-src="{{section.settings.bannerIMG4 | img_url: '300x'}}">

                    <span class="grid_item-button">{{section.settings.buttonText4}}</span>

                </a>

            </div>

            <div class="grid_row">

                <a href="{{section.settings.buttonLink5}}" class="grid_item">

                    <img class="lazyload" data-src="{{section.settings.bannerIMG5 | img_url: '300x'}}">

                    <span class="grid_item-button">{{section.settings.buttonText5}}</span>

                </a>

            </div>

            <div class="grid_row-wide">

                <a href="{{section.settings.buttonLink6}}" class="grid_item">
                    <img class="lazyload" data-src="{{section.settings.bannerIMG6 | img_url: '600x300'}}">
                    <span class="grid_item-button">{{section.settings.buttonText6}}</span>
                </a>

            </div>

        </div>

    </div>

</div>





