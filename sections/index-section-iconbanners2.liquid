          "content": "Colors"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#2879fe"
        },
        {
          "type": "color",
          "id": "icon_colorh",
          "label": "Icon color",
          "default": "#2879fe"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon Banners type 2",
      "category": "Banner",
        "blocks": [
          {
            "type": "item",
            "settings": {
