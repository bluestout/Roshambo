            }
          },
          {
            "type": "item",
            "settings": {
              "icon": "icon-e-09",
              "text1": "30 DAYS returns"
            }
          },
          {
            "type": "item",
            "settings": {
              "icon": "icon-f-89",
              "text1": "4.5/5 on Powerreviews"
            }
          }
        ]
    }
  ]
}
{% endschema %}