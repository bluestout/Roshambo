          "default":   4
        },
        {
          "type":      "range",
          "id":        "border_width_a",
          "min":       0,
          "max":       8,
          "step":      1,
          "unit":      "px",
          "label":     "Border active width",
          "default":   4
        },
        {
          "type":      "range",
          "id":        "image_opacity",
          "min":       0,
          "max":       100,
          "step":      1,
          "unit":      "%",
          "label":     "Image opacity",
          "default":   100
        },
        {
          "type":      "range",
          "id":        "image_opacity_a",
          "min":       0,
          "max":       100,
          "step":      1,
          "unit":      "%",
          "label":     "Image active opacity",
          "default":   100
        },
        {
          "type": "header",
          "content": "Base Colors"
        },
        {
          "type": "color",
          "id": "textc",
          "label": "Text color",
          "default": "#191919"
        },
        {
          "type": "color",
          "id": "bgc",
          "label": "Background color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "borderc",
          "label": "Border color",
          "default": "#191919"
        },
        {
          "type": "header",
          "content": "Active Colors"
        },
        {
          "type": "color",
          "id": "textac",
          "label": "Text active color",
          "default": "#191919"
        },
        {
          "type": "color",
          "id": "bgac",
          "label": "Background color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "borderac",
          "label": "Border active color",
          "default": "#191919"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Small Simple Banners",
      "category": "Banner",
      "blocks": [
      ]
    }
  ]
